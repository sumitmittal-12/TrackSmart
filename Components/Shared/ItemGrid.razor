@using TrackSmart.DTOs

<div class="row mb-4">
    <div class="col-md-6">
        <div class="input-group shadow-sm">
            <input type="text"
                   class="form-control border-start-0"
                   placeholder="Search by item or company..."
                   @bind-value="searchTerm"
                   @bind-value:event="oninput" />
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in FilteredItems)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    @* 1. THE COMPANY NAME (Protected with text-truncate) *@
                    <div class="text-muted small fw-bold text-uppercase mb-1 text-truncate" title="@item.CompanyName" style="letter-spacing: 0.5px;">
                        @(string.IsNullOrWhiteSpace(item.CompanyName) ? "Independent Brand" : item.CompanyName)
                    </div>

                    @* 2. THE ITEM NAME & BADGE *@
                    <h4 class="card-title d-flex justify-content-between align-items-start mb-3">
                        <span class="fw-bolder text-dark text-truncate me-2" title="@item.Name">@item.Name</span>

                        <div>
                            @if (item.StockCount <= 0)
                            {
                                <span class="badge bg-secondary px-3 py-2 rounded-pill shadow-sm small">
                                    <i class="bi bi-x-circle-fill me-1"></i>Out of Stock
                                </span>
                            }
                            else if (item.StockCount <= item.LowStockThreshold)
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill shadow-sm small">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Few left
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success px-3 py-2 rounded-pill shadow-sm small">
                                    <i class="bi bi-check-circle-fill me-1"></i>Available
                                </span>
                            }
                        </div>
                    </h4>

                    @* 3. PRICING BLOCK *@
                    <div class="mt-3 bg-light p-3 rounded-3 border border-secondary-subtle">
                        <p class="mb-1 text-muted text-decoration-line-through">
                            <small>Original: @item.OriginalPrice.ToString("C")</small>
                        </p>
                        <p class="mb-1 text-success fw-bold">Discount: @item.DiscountPercentage% Off</p>
                        <p class="mb-0 fs-5 fw-bold text-primary">Final: @item.FinalPrice.ToString("C")</p>
                    </div>

                    <hr class="my-4" />

                    @* INJECTION POINT *@
                    @if (ActionArea != null)
                    {
                        <div class="mt-auto">
                            @ActionArea(item)
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<ItemDto> Items { get; set; } = new();

    [Parameter]
    public RenderFragment<ItemDto>? ActionArea { get; set; }

    private string searchTerm = string.Empty;

    // 4. UPDATED SEARCH LOGIC: Now filters by Name OR CompanyName
    private IEnumerable<ItemDto> FilteredItems =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? Items
            : Items.Where(i =>
                (i.Name != null && i.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                (i.CompanyName != null && i.CompanyName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            );
}