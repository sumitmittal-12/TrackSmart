@page "/add-supplier"
@rendermode InteractiveServer

@using TrackSmart.DTOs
@using TrackSmart.Models
@using TrackSmart.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject SupplierService SupplierService
@inject ItemService ItemService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS

@attribute [Authorize(Roles = "Retailer")]
<PageTitle>Add Supplier - TrackSmart</PageTitle>

<div style="background-color: #f4f6f8; min-height: calc(100vh - 60px);" class="py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="mb-3">
                    <button class="btn btn-link text-decoration-none text-muted p-0" @onclick="GoBack">
                        <i class="bi bi-arrow-left me-1"></i> Back to Inventory
                    </button>
                </div>

                <div class="card shadow-sm border-0 rounded-4 bg-white">
                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold">Add New Supplier</h2>
                            <p class="text-muted">Register a new vendor and link their items.</p>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <EditForm Model="newSupplier" OnValidSubmit="HandleValidSubmit" FormName="addSupplierForm">
                            <DataAnnotationsValidator />

                            <!-- Basic Info -->
                            <h6 class="fw-bold text-muted mb-3">Contact Information</h6>
                            <div class="form-floating mb-3">
                                <InputText @bind-Value="newSupplier.CompanyName" id="compName" class="form-control" placeholder=" " />
                                <label for="compName">Company Name</label>
                                <ValidationMessage For="() => newSupplier.CompanyName" class="text-danger small" />
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6 form-floating">
                                    <InputText @bind-Value="newSupplier.ContactEmail" id="email" class="form-control" placeholder=" " />
                                    <label for="email" class="ms-2">Contact Email</label>
                                    <ValidationMessage For="() => newSupplier.ContactEmail" class="text-danger small" />
                                </div>
                                <div class="col-md-6 form-floating">
                                    <InputText @bind-Value="newSupplier.ContactPhone" id="phone" class="form-control" placeholder=" " />
                                    <label for="phone" class="ms-2">Phone Number</label>
                                    <ValidationMessage For="() => newSupplier.ContactPhone" class="text-danger small" />
                                </div>
                            </div>

                            <!-- Address Info -->
                            <h6 class="fw-bold text-muted mb-3">Address Information</h6>
                            <div class="form-floating mb-3">
                                <InputText @bind-Value="newSupplier.AddressLine" id="address" class="form-control" placeholder=" " />
                                <label for="address">Address Line</label>
                                <ValidationMessage For="() => newSupplier.AddressLine" class="text-danger small" />
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-5 form-floating">
                                    <InputText @bind-Value="newSupplier.City" id="city" class="form-control" placeholder=" " />
                                    <label for="city" class="ms-2">City</label>
                                </div>
                                <div class="col-md-4 form-floating">
                                    <InputText @bind-Value="newSupplier.State" id="state" class="form-control" placeholder=" " />
                                    <label for="state" class="ms-2">State</label>
                                </div>
                                <div class="col-md-3 form-floating">
                                    <InputText @bind-Value="newSupplier.PostalCode" id="zip" class="form-control" placeholder=" " />
                                    <label for="zip" class="ms-2">Zip Code</label>
                                </div>
                            </div>

                            <!-- Searchable Item Selection -->
                            <h6 class="fw-bold text-muted mb-3">Provided Items</h6>

                            <div class="row mb-4">
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control ps-0"
                                           placeholder="  Add items..."
                                           @bind="searchTerm"
                                           @bind:event="oninput"
                                           @onfocus="() => isItemListVisible = true" />
                                </div>

                                @if (isItemListVisible)
                                {
                                    <div class="border rounded-3 p-3 bg-light position-relative shadow-sm" style="max-height: 200px; overflow-y: auto;">
                                        <!-- Close Button -->
                                        <button type="button" class="btn-close position-absolute top-0 end-0 m-2" style="font-size: 0.75rem;" aria-label="Close" @onclick="() => isItemListVisible = false"></button>

                                        <div class="mt-2">
                                            @if (FilteredItems != null && FilteredItems.Any())
                                            {
                                                @foreach (var item in FilteredItems)
                                                {
                                                    <div class="form-check mb-2">
                                                        <input class="form-check-input shadow-sm" type="checkbox" id="item_@item.Id"
                                                               checked="@newSupplier.ItemIds.Contains(item.Id)"
                                                               @onchange="@(e => ToggleItemSelection(item.Id, e.Value))" />
                                                        <label class="form-check-label" for="item_@item.Id">
                                                            <span class="fw-medium">@item.Name</span>
                                                            <span class="text-muted small">(@item.CompanyName)</span>
                                                        </label>
                                                    </div>
                                                }
                                            }
                                            else if (availableItems == null)
                                            {
                                                <div class="text-muted small text-center"><span class="spinner-border spinner-border-sm me-2"></span>Loading items...</div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small text-center">No matching items found.</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <button type="submit" class="w-100 btn btn-lg btn-primary fw-bold shadow-sm mt-2">Save Supplier</button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private CreateSupplierDto newSupplier { get; set; } = new();

    private List<ItemDto>? availableItems;
    private string searchTerm = string.Empty;
    private string? errorMessage;
    private string? currentRetailerId;

    // Controls the visibility of the item list
    private bool isItemListVisible = false;

    // Computed property to dynamically filter items as the user types
    private IEnumerable<ItemDto>? FilteredItems =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? availableItems
            : availableItems?.Where(i =>
                i.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                i.CompanyName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = await UserManager.GetUserAsync(authState.User);

            if (user != null)
            {
                currentRetailerId = user.Id;
                availableItems = await ItemService.GetItemsAsync(currentRetailerId);
            }
        }
        catch (Exception)
        {
            errorMessage = "Failed to load available items.";
        }
    }

    // Handles the checkbox click events manually
    private void ToggleItemSelection(int itemId, object? checkedValue)
    {
        if (checkedValue is bool isChecked)
        {
            if (isChecked && !newSupplier.ItemIds.Contains(itemId))
            {
                newSupplier.ItemIds.Add(itemId);
            }
            else if (!isChecked && newSupplier.ItemIds.Contains(itemId))
            {
                newSupplier.ItemIds.Remove(itemId);
            }
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (string.IsNullOrEmpty(currentRetailerId)) return;

            // Save the supplier
            await SupplierService.CreateSupplierAsync(newSupplier, currentRetailerId);

            // Redirect cleanly
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving supplier: {ex.Message}";
        }
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");
}