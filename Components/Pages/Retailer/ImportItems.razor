@page "/import-items"
@rendermode InteractiveServer

@using TrackSmart.Services
@using TrackSmart.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ItemService ItemService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS

@attribute [Authorize(Roles = "Retailer")]
<PageTitle>Import Items - TrackSmart</PageTitle>

<div style="background-color: #f4f6f8; min-height: calc(100vh - 60px);" class="py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="mb-3">
                    <button class="btn btn-link text-decoration-none text-muted p-0" @onclick="GoBack">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </button>
                </div>

                <div class="card shadow-sm border-0 rounded-4 bg-white">
                    <div class="card-body p-4 p-md-5 text-center">
                        <h2 class="fw-bold mb-3">Bulk Import Items</h2>
                        <p class="text-muted mb-4">Upload an Excel (.xlsx) file to add multiple items at once.</p>

                        @if (!string.IsNullOrEmpty(statusMessage))
                        {
                            <div class="alert @statusClass alert-dismissible fade show text-start" role="alert">
                                @statusMessage
                                <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
                            </div>
                        }

                        <div class="border border-2 border-dashed rounded-4 p-5 mb-4 bg-light position-relative">
                            <i class="bi bi-file-earmark-excel text-success mb-3" style="font-size: 3rem;"></i>
                            <h6 class="fw-bold">Select Excel File</h6>
                            <p class="text-muted small">Max file size: 5MB</p>

                            <InputFile OnChange="HandleFileSelection" class="form-control" accept=".xlsx" />

                            @if (selectedFile != null)
                            {
                                <div class="mt-3 text-success fw-bold small">
                                    <i class="bi bi-check-circle-fill me-1"></i> Ready: @selectedFile.Name
                                </div>
                            }
                        </div>

                        <button class="btn btn-primary btn-lg w-100 fw-bold mb-4 shadow-sm" 
                                @onclick="ProcessUpload" 
                                disabled="@(selectedFile == null || isUploading)">
                            @if (isUploading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Importing...</span>
                            }
                            else
                            {
                                <i class="bi bi-cloud-arrow-up-fill me-2"></i> <span>Upload</span>
                            }
                        </button>

                        <div class="text-start bg-light p-3 rounded-3 text-muted small">
                            <span class="fw-bold text-dark"><i class="bi bi-info-circle me-1"></i> Expected Columns (Row 1 as Headers):</span>
                            <ul class="mb-0 mt-1 ps-3">
                                <li>A: Item Name (Required)</li>
                                <li>B: Brand Name</li>
                                <li>C: Description</li>
                                <li>D: Original Price (Number)</li>
                                <li>E: Discount % (Number)</li>
                                <li>F: Stock Count (Number)</li>
                                <li>G: Low Stock Threshold (Number)</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (showSuccessModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-body p-5 text-center">
                    <i class="bi bi-check-circle-fill text-success mb-3 d-block" style="font-size: 4rem;"></i>
                    <h3 class="fw-bold mb-3">Import Successful!</h3>
                    <p class="text-muted mb-4 fs-5">
                        <strong>@importedItemCount</strong> items were successfully processed and added to your inventory.
                    </p>
                    <button class="btn btn-success btn-lg px-5 fw-bold rounded-pill" @onclick="CloseModalAndNavigate">
                        Continue to Inventory
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string? statusMessage;
    private string statusClass = "alert-info";
    private string? currentRetailerId;

    private IBrowserFile? selectedFile;
    private bool isUploading = false;
    
    private bool showSuccessModal = false;
    private int importedItemCount = 0;

    private const long MaxFileSize = 1024 * 1024 * 5;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentRetailerId = user.Id;
        }
    }

    private void HandleFileSelection(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        statusMessage = null;
    }

    private async Task ProcessUpload()
    {
        if (selectedFile == null || string.IsNullOrEmpty(currentRetailerId)) return;

        if (!selectedFile.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
        {
            ShowMessage("Please upload a valid .xlsx Excel file.", "alert-warning");
            return;
        }

        try
        {
            isUploading = true;
            statusMessage = null;
            StateHasChanged(); 

            using var stream = selectedFile.OpenReadStream(MaxFileSize);
            using var memoryStream = new MemoryStream();
            
            await stream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            importedItemCount = await ItemService.ImportItemsFromExcelAsync(memoryStream, currentRetailerId);
            showSuccessModal = true;
            
            selectedFile = null;
        }
        catch (Exception ex)
        {
            ShowMessage($"An error occurred during import: {ex.Message}", "alert-danger");
        }
        finally
        {
            isUploading = false;
        }
    }

    private void CloseModalAndNavigate()
    {
        showSuccessModal = false;
        NavManager.NavigateTo("/retailer/inventory");
    }

    private void ShowMessage(string message, string cssClass)
    {
        statusMessage = message;
        statusClass = cssClass;
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");
}