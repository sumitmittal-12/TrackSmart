@page "/retailer/inventory"
@rendermode InteractiveServer

@using TrackSmart.DTOs
@using TrackSmart.Services
@using TrackSmart.Models
@using TrackSmart.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ItemService ItemService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

@attribute [Authorize(Roles = "Retailer")]
<PageTitle>My Inventory - TrackSmart</PageTitle>

@* 1. ADDED: The same contrast wrapper used on the auth and form pages *@
<div style="background-color: #f4f6f8; min-height: calc(100vh - 60px);" class="py-4">
    <div class="container mb-5">

        @* Page Header *@
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom border-secondary-subtle">
            <div>
                <h2 class="fw-bold mb-1">My Inventory</h2>
                <p class="text-muted mb-0">Manage your store's products and stock levels.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/add-item" class="btn btn-primary fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i>+ Add New Item
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <strong>Error:</strong> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (items == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Loading inventory...</p>
            </div>
        }
        else if (!items.Any())
        {
            @* Changed to bg-white so it contrasts against the new gray page background *@
            <div class="card shadow-sm border-0 rounded-4 bg-white text-center py-5">
                <div class="card-body">
                    <i class="bi bi-box-seam text-muted mb-3" style="font-size: 3rem;"></i>
                    <h4 class="fw-bold">Your inventory is empty</h4>
                    <p class="text-muted">You haven't added any products to your store yet.</p>
                    <a href="/add-item" class="btn btn-primary fw-bold">Get Started</a>
                </div>
            </div>
        }
        else
        {
            <ItemGrid Items="items">
                <ActionArea Context="item">

                    @* INLINE STOCK CONTROLS *@
                    <div class="bg-light rounded-3 p-2 mb-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <small class="text-muted fw-bold text-uppercase" style="font-size: 1rem;">Quick Stock Update</small>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group btn-group-sm shadow-sm w-50" role="group">
                                @* 2. FIXED: Made buttons explicitly text-black and btn-light for visibility *@
                                <button type="button" class="btn btn-light border text-black fw-bold"
                                        @onclick="() => UpdateStockAsync(item, -1)"
                                        disabled="@(item.StockCount <= 0)">
                                    <i class="bi bi-dash-lg">-</i>
                                </button>

                                @* Visual Display of Current Stock *@
                                <span class="btn btn-white border-top border-bottom disabled text-black fw-bold" style="opacity: 1;">
                                    @item.StockCount
                                </span>

                                @* 2. FIXED: Increment button matches the black styling *@
                                <button type="button" class="btn btn-light border text-black fw-bold"
                                        @onclick="() => UpdateStockAsync(item, 1)">
                                    <i class="bi bi-plus-lg">+</i>
                                </button>
                            </div>
                        </div>
                    </div>

                    @* Standard Action Buttons *@
                    <div class="row g-2">
                        <div class="col-6">
                            <a href="/edit-item/@item.Id" class="btn btn-outline-primary w-100 btn-sm fw-bold">
                                <i class="bi bi-pencil-square me-1"></i> Edit
                            </a>
                        </div>
                        <div class="col-6">
                            <button class="btn btn-outline-danger w-100 btn-sm fw-bold" @onclick="() => OpenDeleteModal(item.Id)">
                                <i class="bi bi-trash3 me-1"></i> Delete
                            </button>
                        </div>
                    </div>
                </ActionArea>
            </ItemGrid>
        }

        @* Delete Modal *@
        @if (showDeleteModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(3px); z-index: 1050;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow-lg border-0 rounded-4">
                        <div class="modal-header bg-danger text-white border-0 rounded-top-4">
                            <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion</h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="mb-0 fs-5 text-center">Are you completely sure you want to delete this item?</p>
                            <p class="text-muted text-center mt-2 small">This action cannot be reversed and it will be removed from your catalog instantly.</p>
                        </div>
                        <div class="modal-footer bg-light border-0 rounded-bottom-4 d-flex">
                            <button type="button" class="btn btn-secondary flex-fill fw-bold" @onclick="CloseModal">Cancel</button>
                            <button type="button" class="btn btn-danger flex-fill fw-bold" @onclick="ExecuteDelete">Yes, Delete It</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<ItemDto>? items;
    private string? errorMessage;
    private string? currentRetailerId;

    private bool showDeleteModal = false;
    private int itemToDeleteId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            errorMessage = null;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;

            if (userPrincipal.Identity is not null && userPrincipal.Identity.IsAuthenticated)
            {
                var appUser = await UserManager.GetUserAsync(userPrincipal);
                if (appUser != null)
                {
                    currentRetailerId = appUser.Id;
                }
            }

            if (!string.IsNullOrEmpty(currentRetailerId))
            {
                items = await ItemService.GetItemsAsync(currentRetailerId);
            }
            else
            {
                errorMessage = "Authentication failed. Could not identify retailer account.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not load inventory: {ex.Message}";
            items = new List<ItemDto>();
        }
    }

    private async Task UpdateStockAsync(ItemDto item, int amountChange)
    {
        // Prevent going below zero just in case HTML disabled state is bypassed
        if (item.StockCount + amountChange < 0) return;

        // Immediately update the UI for a snappy experience
        item.StockCount += amountChange;

        try
        {
            if (!string.IsNullOrEmpty(currentRetailerId))
            {
                // Map the existing item data to a CreateItemDto to reuse your UpdateItemAsync method
                var updateDto = new CreateItemDto
                {
                    Name = item.Name,
                    OriginalPrice = item.OriginalPrice,
                    DiscountPercentage = item.DiscountPercentage,
                    StockCount = item.StockCount,
                    LowStockThreshold = item.LowStockThreshold
                };

                await ItemService.UpdateItemAsync(item.Id, updateDto, currentRetailerId);
            }
        }
        catch (Exception ex)
        {
            // If the database save fails, revert the UI and show an error
            item.StockCount -= amountChange;
            errorMessage = $"Failed to update stock for {item.Name}: {ex.Message}";
        }
    }

    private void OpenDeleteModal(int id)
    {
        itemToDeleteId = id;
        showDeleteModal = true;
    }

    private void CloseModal()
    {
        showDeleteModal = false;
    }

    private async Task ExecuteDelete()
    {
        try
        {
            errorMessage = null;

            if (!string.IsNullOrEmpty(currentRetailerId))
            {
                await ItemService.DeleteItemAsync(itemToDeleteId, currentRetailerId);
                items = await ItemService.GetItemsAsync(currentRetailerId);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete item: {ex.Message}";
        }
        finally
        {
            showDeleteModal = false;
        }
    }
}