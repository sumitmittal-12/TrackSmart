@page "/item-directory"
@rendermode InteractiveServer

@using TrackSmart.DTOs
@using TrackSmart.Services
@using TrackSmart.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ItemService ItemService
@inject SupplierService SupplierService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

@attribute [Authorize(Roles = "Retailer")]
<PageTitle>Item Directory - TrackSmart</PageTitle>

<!-- Added the light grey background wrapper to match your theme -->
<div style="background-color: #f4f6f8; min-height: calc(100vh - 60px);" class="py-4">
    <div class="container">
        
        <!-- Header, Search Bar, and Add Button -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-5 mb-3 mb-md-0">
                <h2 class="fw-bold mb-0 text-dark">Item Directory</h2>
                <p class="text-muted mb-0">Browse your inventory and their suppliers.</p>
            </div>
            <div class="col-md-7 d-flex flex-column flex-md-row justify-content-md-end gap-3">
                <!-- Search Bar -->
                <div class="input-group shadow-sm" style="max-width: 350px;">
                    <input type="text" class="form-control border-start-0 ps-0" 
                           placeholder="  Search items or brands..." 
                           @bind="searchTerm" 
                           @bind:event="oninput" />
                </div>
            </div>
        </div>

        @if (items == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Loading catalog...</p>
            </div>
        }
        else if (!items.Any())
        {
            <div class="alert alert-info text-center py-4 border-0 shadow-sm rounded-4">
                <h5 class="fw-bold">No items found.</h5>
                <p class="mb-0">Click the "Add Item" button above to populate your inventory.</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush shadow-sm rounded-4 border bg-white overflow-hidden">
                <!-- Loop through FilteredItems instead of items -->
                @if (FilteredItems != null && FilteredItems.Any())
                {
                    @foreach (var item in FilteredItems)
                    {
                        <div class="list-group-item py-4 border-bottom border-light">
                            
                            <!-- ITEM NAME (COMPANY NAME) IN UPPERCASE -->
                            <h5 class="fw-bolder text-uppercase mb-2 text-dark" style="letter-spacing: 0.5px;">
                                @item.Name.ToUpper() (@item.CompanyName.ToUpper())
                            </h5>

                            <!-- ITEM DETAILS (Expandable) -->
                            <details class="mb-4 ms-2">
                                <summary class="small fw-bold text-success mb-2" style="cursor: pointer; user-select: none;">
                                    View Item Details
                                </summary>
                                <div class="p-3 bg-light rounded-3 border border-light shadow-sm small text-dark">
                                    <div class="row g-2">
                                        <div class="col-12 col-md-4">
                                            <p class="mb-1">
                                                <i class="bi bi-tag-fill text-muted me-2"></i> 
                                                <span class="fw-semibold">Price:</span> Rs.@item.OriginalPrice.ToString("0.00")
                                            </p>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <p class="mb-1">
                                                <i class="bi bi-percent text-muted me-2"></i> 
                                                <span class="fw-semibold">Discount:</span> @item.DiscountPercentage.ToString("0.##")%
                                            </p>
                                        </div>
                                        <div class="col-12 col-md-4">
                                            <p class="mb-1">
                                                <i class="bi bi-boxes text-muted me-2"></i> 
                                                <span class="fw-semibold">Stock:</span> @item.StockCount <span class="text-muted">(Min: @item.LowStockThreshold)</span>
                                            </p>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="col-12 mt-2 pt-2 border-top border-light">
                                                <p class="mb-0 text-muted fst-italic">
                                                    "@item.Description"
                                                </p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </details>

                            <!-- Indented section for the Suppliers -->
                            <div class="ms-4 ms-md-5 border-start border-3 border-primary ps-4 py-1">
                                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Sourced From:</h6>
                                
                                @if (item.Suppliers != null && item.Suppliers.Any())
                                {
                                    @foreach (var supplier in item.Suppliers)
                                    {
                                        <div class="mb-3 last-child-mb-0">
                                            <!-- Supplier Name as a Heading -->
                                            <h6 class="fw-bold text-dark mb-1">
                                                <i class="bi bi-truck text-primary me-2"></i>@supplier.CompanyName.ToUpper()
                                            </h6>
                                            
                                            <!-- Native Details tag for expandable contact info -->
                                            <details class="mt-2">
                                                <summary class="small fw-bold text-primary mb-2" style="cursor: pointer; user-select: none;">
                                                    View Supplier Details
                                                </summary>
                                                <div class="p-3 bg-light rounded-3 border border-light shadow-sm small text-dark">
                                                    <div class="row g-2">
                                                        <div class="col-12 col-md-6">
                                                            <p class="mb-1">
                                                                <i class="bi bi-envelope-fill text-muted me-2"></i> 
                                                                <span class="fw-semibold">Email:</span> @supplier.ContactEmail
                                                            </p>
                                                        </div>
                                                        <div class="col-12 col-md-6">
                                                            <p class="mb-1">
                                                                <i class="bi bi-telephone-fill text-muted me-2"></i> 
                                                                <span class="fw-semibold">Phone:</span> @supplier.ContactPhone
                                                            </p>
                                                        </div>
                                                        <div class="col-12 mt-2">
                                                            <p class="mb-0">
                                                                <i class="bi bi-geo-alt-fill text-muted me-2"></i> 
                                                                <span class="fw-semibold">Address:</span> 
                                                                @(string.IsNullOrWhiteSpace(supplier.AddressLine) ? "Not provided" : $"{supplier.AddressLine}, {supplier.City}, {supplier.State} {supplier.PostalCode}")
                                                            </p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </details>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic d-flex align-items-center">
                                        <i class="bi bi-info-circle me-2"></i> Independent / No Supplier Assigned
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-search fs-1 mb-3 d-block"></i>
                        No items match your search for "@searchTerm".
                    </div>
                }
            </div>
        }
    </div>
</div>


@code {
    private List<ItemDto>? items;
    private string searchTerm = string.Empty;
    private string? currentRetailerId;

    // Computed property to dynamically filter items as the user types
    private IEnumerable<ItemDto>? FilteredItems =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? items
            : items?.Where(i => 
                i.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                i.CompanyName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentRetailerId = user.Id;
            items = await ItemService.GetItemsWithSuppliersAsync(currentRetailerId);
        }
    }
}