@page "/directory"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Retailer")]
<PageTitle>Directory Hub - TrackSmart</PageTitle>

<div style="background-color: #f4f6f8; min-height: calc(100vh - 60px);" class="py-4">
    
    <div class="container mb-4">
        
        <!-- Header row with relative positioning for absolute children -->
        <div class="position-relative d-flex justify-content-center align-items-center py-2">
            
            <!-- Explicit Link to Inventory (Replaces history.back) -->
            <a href="/retailer/inventory" class="btn btn-link text-decoration-none text-muted p-0 position-absolute start-0">
                <i class="bi bi-arrow-left me-1"></i> 
                <span class="d-none d-sm-inline">Back to Inventory</span>
                <span class="d-inline d-sm-none">Back</span>
            </a>

            <!-- The Realistic Toggle Switch (Perfectly Centered) -->
            <div class="segmented-control @(isSupplierMode ? "" : "show-items")">
                
                <!-- The sliding background pill -->
                <div class="slider"></div>

                <!-- Supplier Button (Now First) -->
                <button type="button" class="@(isSupplierMode ? "active" : "")" @onclick="() => isSupplierMode = true">
                    <i class="bi bi-truck me-2"></i> Suppliers
                </button>
                                
                <!-- Item Button (Now Second) -->
                <button type="button" class="@(!isSupplierMode ? "active" : "")" @onclick="() => isSupplierMode = false">
                    <i class="bi bi-box-seam me-2"></i> Items
                </button>
                
            </div>
        </div>
    </div>

    @* Component Rendering *@
    @if (isSupplierMode)
    {
        <SupplierDirectory />
    }
    else
    {
        <ItemDirectory />
    }
    
</div>

@code {
    // Defaults to true, making Supplier Directory the default view    
    private bool isSupplierMode = true; 
}