@page "/supplier-directory"
@rendermode InteractiveServer

@using TrackSmart.DTOs
@using TrackSmart.Services
@using TrackSmart.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject SupplierService SupplierService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS

@attribute [Authorize(Roles = "Retailer")]
<PageTitle>Supplier Directory - TrackSmart</PageTitle>

<!-- Light grey background wrapper -->
<div style="background-color: #f4f6f8; min-height: calc(100vh - 60px);" class="py-4">
    <div class="container">
        
        <!-- Header, Search Bar, and Add Button -->
        <div class="row mb-4 align-items-center">
            <div class="col-md-5 mb-3 mb-md-0">
                <h2 class="fw-bold mb-0 text-dark">Supplier Directory</h2>
                <p class="text-muted mb-0">Browse your vendors and the items they provide.</p>
            </div>
            <div class="col-md-7 d-flex flex-column flex-md-row justify-content-md-end gap-3">
                <!-- Search Bar -->
                <div class="input-group shadow-sm" style="max-width: 350px;">
                    <input type="text" class="form-control border-start-0 ps-0" 
                           placeholder="  Search suppliers..." 
                           @bind="searchTerm" 
                           @bind:event="oninput" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <strong>Error:</strong> @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
            </div>
        }

        @if (suppliers == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Loading suppliers...</p>
            </div>
        }
        else if (!suppliers.Any())
        {
            <div class="alert alert-info text-center py-4 border-0 shadow-sm rounded-4">
                <h5 class="fw-bold">No suppliers found.</h5>
                <p class="mb-0">Click the "Add Supplier" button above to register your first vendor.</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush shadow-sm rounded-4 border bg-white overflow-hidden">
                <!-- Loop through FilteredSuppliers instead of suppliers -->
                @if (FilteredSuppliers != null && FilteredSuppliers.Any())
                {
                    @foreach (var supplier in FilteredSuppliers)
                    {
                        <div class="list-group-item py-4 border-bottom border-light">
                            
                            <!-- SUPPLIER HEADER & ACTIONS -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bolder text-uppercase text-dark mb-0" style="letter-spacing: 0.5px;">
                                    @supplier.CompanyName.ToUpper()
                                </h5>
                                
                                <!-- Action Buttons (Edit & Delete) -->
                                <div class="d-flex gap-2">
                                    <a href="/edit-supplier/@supplier.Id" class="btn btn-sm btn-outline-primary rounded-pill shadow-sm px-3">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill shadow-sm px-3" @onclick="() => OpenDeleteModal(supplier.Id)">
                                        <i class="bi bi-trash3 me-1"></i> Delete
                                    </button>
                                </div>
                            </div>

                            <!-- SUPPLIER CONTACT DETAILS (Expandable - Changed to Green/text-success) -->
                            <details class="mb-4 ms-2">
                                <summary class="small fw-bold text-success mb-2" style="cursor: pointer; user-select: none;">
                                    View Contact Details
                                </summary>
                                <div class="p-3 bg-light rounded-3 border border-light shadow-sm small text-dark">
                                    <div class="row g-2">
                                        <div class="col-12 col-md-6">
                                            <p class="mb-1">
                                                <i class="bi bi-envelope-fill text-muted me-2"></i> 
                                                <span class="fw-semibold">Email:</span> @supplier.ContactEmail
                                            </p>
                                        </div>
                                        <div class="col-12 col-md-6">
                                            <p class="mb-1">
                                                <i class="bi bi-telephone-fill text-muted me-2"></i> 
                                                <span class="fw-semibold">Phone:</span> @supplier.ContactPhone
                                            </p>
                                        </div>
                                        <div class="col-12 mt-2">
                                            <p class="mb-0">
                                                <i class="bi bi-geo-alt-fill text-muted me-2"></i> 
                                                <span class="fw-semibold">Address:</span> 
                                                @(string.IsNullOrWhiteSpace(supplier.AddressLine) ? "Not provided" : $"{supplier.AddressLine}, {supplier.City}, {supplier.State} {supplier.PostalCode}")
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </details>

                            <!-- INDENTED SECTION FOR SUPPLIED ITEMS -->
                            <div class="ms-4 ms-md-5 border-start border-3 border-primary ps-4 py-1">
                                <h6 class="fw-bold text-secondary text-uppercase small mb-3">Supplied Items:</h6>
                                
                                @if (supplier.SuppliedItems != null && supplier.SuppliedItems.Any())
                                {
                                    @foreach (var item in supplier.SuppliedItems)
                                    {
                                        <div class="mb-3 last-child-mb-0">
                                            <!-- Item Name -->
                                            <h6 class="fw-bold text-dark mb-1">
                                                <i class="bi bi-box-seam text-primary me-2"></i>@item.Name 
                                                <span class="text-muted fw-normal">(@item.CompanyName)</span>
                                            </h6>
                                            
                                            <!-- ITEM DETAILS (Expandable) -->
                                            <details class="mt-2">
                                                <summary class="small fw-bold text-primary mb-2" style="cursor: pointer; user-select: none;">
                                                    View Item Details
                                                </summary>
                                                <div class="p-3 bg-light rounded-3 border border-light shadow-sm small text-dark">
                                                    <div class="row g-2">
                                                        <div class="col-12 col-md-4">
                                                            <p class="mb-1">
                                                                <i class="bi bi-tag-fill text-muted me-2"></i> 
                                                                <span class="fw-semibold">Price:</span> Rs.@item.OriginalPrice.ToString("0.00")
                                                            </p>
                                                        </div>
                                                        <div class="col-12 col-md-4">
                                                            <p class="mb-1">
                                                                <i class="bi bi-percent text-muted me-2"></i> 
                                                                <span class="fw-semibold">Discount:</span> @item.DiscountPercentage.ToString("0.##")%
                                                            </p>
                                                        </div>
                                                        <div class="col-12 col-md-4">
                                                            <p class="mb-1">
                                                                <i class="bi bi-boxes text-muted me-2"></i> 
                                                                <span class="fw-semibold">Stock:</span> @item.StockCount<span class="text-muted">(Min: @item.LowStockThreshold)</span>
                                                            </p>
                                                        </div>
                                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                                        {
                                                            <div class="col-12 mt-2 pt-2 border-top border-light">
                                                                <p class="mb-0 text-muted fst-italic">
                                                                    "@item.Description"
                                                                </p>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </details>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic d-flex align-items-center">
                                        <i class="bi bi-info-circle me-2"></i> No items currently mapped.
                                    </span>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-search fs-1 mb-3 d-block"></i>
                        No suppliers match your search for "@searchTerm".
                    </div>
                }
            </div>
        }

        @* Delete Confirmation Modal *@
        @if (showDeleteModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(3px); z-index: 1050;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content shadow-lg border-0 rounded-4">
                        <div class="modal-header bg-danger text-white border-0 rounded-top-4">
                            <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion</h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="mb-0 fs-5 text-center">Are you sure you want to remove this supplier?</p>
                            <p class="text-muted text-center mt-2 small">This will hide them from your directory but keep their data archived.</p>
                        </div>
                        <div class="modal-footer bg-light border-0 rounded-bottom-4 d-flex">
                            <button type="button" class="btn btn-secondary flex-fill fw-bold" @onclick="CloseDeleteModal">Cancel</button>
                            <button type="button" class="btn btn-danger flex-fill fw-bold" @onclick="ExecuteDelete">Yes, Remove</button>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@code {
    private List<SupplierDto>? suppliers;
    private string searchTerm = string.Empty;
    private string? errorMessage;
    private string? currentRetailerId;

    // Delete Modal State
    private bool showDeleteModal = false;
    private int supplierToDeleteId;

    // Computed property to dynamically filter suppliers as the user types
    private IEnumerable<SupplierDto>? FilteredSuppliers =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? suppliers
            : suppliers?.Where(s => 
                s.CompanyName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadSuppliers();
    }

    private async Task LoadSuppliers()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user != null)
        {
            currentRetailerId = user.Id;
            suppliers = await SupplierService.GetSuppliersWithItemsAsync(currentRetailerId);
        }
    }

    // Delete Modal Handlers
    private void OpenDeleteModal(int id)
    {
        supplierToDeleteId = id;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
    }

    private async Task ExecuteDelete()
    {
        try
        {
            errorMessage = null;

            if (!string.IsNullOrEmpty(currentRetailerId))
            {
                await SupplierService.DeleteSupplierAsync(supplierToDeleteId, currentRetailerId);
                
                // Refresh the list after soft deletion
                await LoadSuppliers();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete supplier: {ex.Message}";
        }
        finally
        {
            showDeleteModal = false;
        }
    }
}