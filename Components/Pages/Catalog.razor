@page "/catalog"
@rendermode InteractiveServer

@using TrackSmart.DTOs
@using TrackSmart.Services
@using TrackSmart.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject ItemService ItemService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

@* SECURITY COMMENTED OUT: Allows anyone to view the page during testing *@
@attribute [Authorize]

<PageTitle>Inventory Catalog</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@(string.IsNullOrEmpty(currentUserStoreName) ? "Store" : currentUserStoreName) Inventory</h2>

        <div class="d-flex gap-3 align-items-center">
            <a href="/add-item" class="btn btn-success">+ Add New Item</a>

            <form action="Account/Logout" method="post" class="m-0">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="" />
                <button type="submit" class="btn btn-outline-danger fw-bold shadow-sm">
                    Log Out
                </button>
            </form>
        </div>
    </div>
    <hr />

    @* NEW: Error Message Banner for the try/catch blocks *@
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (items == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Fetching inventory...</p>
        </div>
    }
    else if (!items.Any())
    {
        <div class="alert alert-info text-center">
            No items found in your inventory. Click "Add New Item" to get started!
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="input-group shadow-sm">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search"></i> 🔍
                    </span>
                    <input type="text"
                           class="form-control border-start-0"
                           placeholder="Search inventory by item name..."
                           @bind-value="searchTerm"
                           @bind-value:event="oninput" />
                </div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in FilteredItems)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title d-flex justify-content-between align-items-start">
                                @item.Name
                                @if (item.IsLowStock)
                                {
                                    <span class="badge bg-danger text-white fs-6">Low Stock!</span>
                                }
                            </h5>

                            <div class="mt-3 bg-light p-2 rounded">
                                <p class="mb-1 text-muted text-decoration-line-through">
                                    <small>Original: @item.OriginalPrice.ToString("C")</small>
                                </p>
                                <p class="mb-1 text-success fw-bold">
                                    Discount: @item.DiscountPercentage% Off
                                </p>
                                <p class="mb-1 fs-5 fw-bold text-primary">
                                    Final Price: @item.FinalPrice.ToString("C")
                                </p>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between text-muted">
                                <small>Current Stock: <strong>@item.StockCount</strong></small>
                                <small>Warning Level: <strong>@item.LowStockThreshold</strong></small>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-top-0 d-flex justify-content-end gap-2">
                            <a href="/edit-item/@item.Id" class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteModal(item.Id)">
                                Delete
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (showDeleteModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Confirm Deletion</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">Are you completely sure you want to delete this item from your inventory? This action cannot be reversed.</p>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button type="button" class="btn btn-danger fw-bold" @onclick="ExecuteDelete">Yes, Delete It</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ItemDto>? items;
    private string searchTerm = string.Empty;
    private string? errorMessage; // To hold any caught errors

    // HARDCODED FOR TESTING: Since security is disabled, we need a fallback ID to query the database.
    private string? currentUserStoreName;
    private string? currentRetailerId;

    private bool showDeleteModal = false;
    private int itemToDeleteId;

    private IEnumerable<ItemDto>? FilteredItems =>
        string.IsNullOrWhiteSpace(searchTerm)
            ? items
            : items?.Where(item => item.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            errorMessage = null;

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;

            if (userPrincipal.Identity is not null && userPrincipal.Identity.IsAuthenticated)
            {
                var appUser = await UserManager.GetUserAsync(userPrincipal);

                if (appUser != null)
                {
                    currentUserStoreName = appUser.StoreName;
                    currentRetailerId = appUser.Id;
                }
            }

            // Fetch items using the try/catch block
            if (!string.IsNullOrEmpty(currentRetailerId))
            {
                items = await ItemService.GetItemsAsync(currentRetailerId);
            }
        }
        catch (Exception ex)
        {
            // If the database fails, display the error in the UI
            errorMessage = $"Could not load inventory: {ex.Message}";
            items = new List<ItemDto>(); // Prevents a null reference crash in the HTML
        }
    }

    private void OpenDeleteModal(int id)
    {
        itemToDeleteId = id;
        showDeleteModal = true;
    }

    private void CloseModal()
    {
        showDeleteModal = false;
    }

    private async Task ExecuteDelete()
    {
        try
        {
            errorMessage = null;

            if (!string.IsNullOrEmpty(currentRetailerId))
            {
                // Delete the item and refresh the list
                await ItemService.DeleteItemAsync(itemToDeleteId, currentRetailerId!);
                items = await ItemService.GetItemsAsync(currentRetailerId!);
            }
            
        }
        catch (Exception ex)
        {
            errorMessage = $"Could not delete item: {ex.Message}";
        }
        finally
        {
            // The 'finally' block ensures the modal closes whether the deletion succeeds or fails
            showDeleteModal = false;
        }
    }
}